# Optional: omit both to build the bundled demonstration portfolio.
# Get these two PUBLIC identifiers from your Sanity project.
SANITY_PROJECT_ID=eurg3hlb
SANITY_DATASET=production

# Set to 0 while importing the initial collection; change to 1 when ready.
# The Netlify wrapper defaults to bootstrap mode until this is explicitly 1.
SANITY_CONTENT_ENABLED=0

# For a private dataset only: set a viewer token securely in Netlify.
# Never commit the token or use a NEXT_PUBLIC_/SANITY_STUDIO_ prefix for it.
SANITY_READ_TOKEN=
